<%- include('partials/header') %>
<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">My Todos</h1>
  </div>

  <!-- Filter Bar -->
  <div class="filter-bar">
    <div class="status-filters">
      <a href="/?status=all<%= currentTag ? '&tag=' + currentTag : '' %>"
         class="filter-chip <%= currentStatus === 'all' ? 'active' : '' %>">All</a>
      <a href="/?status=active<%= currentTag ? '&tag=' + currentTag : '' %>"
         class="filter-chip <%= currentStatus === 'active' ? 'active' : '' %>">Active</a>
      <a href="/?status=completed<%= currentTag ? '&tag=' + currentTag : '' %>"
         class="filter-chip <%= currentStatus === 'completed' ? 'active' : '' %>">Completed</a>
    </div>
    <% if (tags.length > 0) { %>
    <div class="tag-filters">
      <a href="/?status=<%= currentStatus %>"
         class="tag-chip <%= !currentTag ? 'active' : '' %>">All Tags</a>
      <% tags.forEach(tag => { %>
      <a href="/?status=<%= currentStatus %>&tag=<%= tag.id %>"
         class="tag-chip <%= currentTag === tag.id ? 'active' : '' %>"
         style="--tag-color: <%= tag.color || '#6366f1' %>">
        <%= tag.name %>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Todo List -->
  <% if (todos.length === 0) { %>
  <div class="empty-state">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
      <path d="M9 11l3 3L22 4"></path>
      <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
    </svg>
    <p>No todos yet. Create your first one!</p>
    <a href="/todos/new" class="btn btn-primary">Add Todo</a>
  </div>
  <% } else { %>
  <div class="todo-list">
    <% todos.forEach(todo => { %>
    <div class="todo-card <%= todo.completed ? 'completed' : '' %> <%= todo.isOverdue ? 'overdue' : '' %>">
      <div class="todo-card-body">
        <div class="todo-meta-top">
          <% if (todo.due_date) { %>
          <span class="due-badge <%= todo.isOverdue ? 'overdue' : '' %>">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <%= new Date(todo.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
          </span>
          <% } %>
        </div>
        <h3 class="todo-title"><%= todo.title %></h3>
        <% if (todo.description) { %>
        <p class="todo-description"><%= todo.description.substring(0, 100) %><%= todo.description.length > 100 ? '...' : '' %></p>
        <% } %>
        <% if (todo.tagObjects && todo.tagObjects.length > 0) { %>
        <div class="todo-tags">
          <% todo.tagObjects.forEach(tag => { %>
          <span class="tag-pill" style="background-color: <%= tag.color || '#6366f1' %>20; color: <%= tag.color || '#6366f1' %>; border-color: <%= tag.color || '#6366f1' %>40">
            <%= tag.name %>
          </span>
          <% }) %>
        </div>
        <% } %>
      </div>
      <div class="todo-card-actions">
        <form method="POST" action="/todos/<%= todo.id %>/complete" style="display:inline">
          <button type="submit" class="btn-icon <%= todo.completed ? 'btn-success' : 'btn-outline' %>" title="<%= todo.completed ? 'Mark incomplete' : 'Mark complete' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </form>
        <a href="/todos/<%= todo.id %>/edit" class="btn-icon btn-outline" title="Edit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
        </a>
        <form method="POST" action="/todos/<%= todo.id %>/delete" style="display:inline"
              onsubmit="return confirm('Delete this todo?')">
          <button type="submit" class="btn-icon btn-danger" title="Delete">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
              <path d="M10 11v6"></path>
              <path d="M14 11v6"></path>
              <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<a href="/todos/new" class="fab" title="Add new todo" aria-label="Add new todo">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
    <line x1="12" y1="5" x2="12" y2="19"></line>
    <line x1="5" y1="12" x2="19" y2="12"></line>
  </svg>
</a>
<%- include('partials/footer') %>
